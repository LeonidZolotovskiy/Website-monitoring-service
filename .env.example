# HTTP server
APP_PORT=8080
LOG_LEVEL=info
CHECK_INTERVAL=60s
HTTP_TIMEOUT=5s

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase

DATABASE_URL=postgres://user:pass@postgres:5432/dbname?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m