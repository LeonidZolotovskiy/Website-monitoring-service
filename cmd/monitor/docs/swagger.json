{
    "swagger": "2.0",
    "info": {
        "description": "API for monitoring site availability",
        "title": "Site Monitor API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns service health status, uptime, version and dependencies state",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "schema": {
                            "$ref": "#/definitions/handler.HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Service is unhealthy",
                        "schema": {
                            "$ref": "#/definitions/handler.HealthResponse"
                        }
                    }
                }
            }
        },
        "/sites": {
            "get": {
                "description": "Returns a list of all monitored sites",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sites"
                ],
                "summary": "Get sites",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Site"
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to get sites",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new site for monitoring",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sites"
                ],
                "summary": "Create site",
                "parameters": [
                    {
                        "description": "Site data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.createSiteRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Site created",
                        "schema": {
                            "$ref": "#/definitions/domain.Site"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or URL",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "Site already exists",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/sites/{id}": {
            "delete": {
                "description": "Deletes a site by ID",
                "tags": [
                    "sites"
                ],
                "summary": "Delete site",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Site ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Site deleted"
                    },
                    "404": {
                        "description": "Site not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/sites/{id}/status": {
            "get": {
                "description": "Returns the latest monitoring status for a site",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "status"
                ],
                "summary": "Get site status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Site ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.SiteStatusResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid site id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Site not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Site": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "handler.DependencyStatus": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "handler.HealthResponse": {
            "type": "object",
            "properties": {
                "dependencies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handler.DependencyStatus"
                    }
                },
                "serverTime": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/handler.HealthStatus"
                },
                "uptime": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "handler.HealthStatus": {
            "type": "string",
            "enum": [
                "healthy",
                "unhealthy"
            ],
            "x-enum-varnames": [
                "HealthHealthy",
                "HealthUnhealthy"
            ]
        },
        "handler.SiteStatusResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "lastCheckedAt": {
                    "type": "string"
                },
                "responseTimeMs": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "handler.createSiteRequest": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        }
    }
}